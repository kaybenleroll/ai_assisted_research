% The shared compact-code header subtracts 0.55em on each side of Shaded.
% Restore that space and add a small separation from surrounding prose while
% retaining the shared compact font and line spacing inside code blocks.
\usepackage{etoolbox}
\BeforeBeginEnvironment{Shaded}{\vspace{0.9em}}
\AfterEndEnvironment{Shaded}{\vspace{0.9em}}

% Allow two-digit chapter and subsection numbers in the contents without
% running them into their titles. Fail the build if the template changes.
\makeatletter
\patchcmd{\l@section}{1.5em}{2.0em}{}{\PackageError{glm}{Unable to adjust section contents spacing}{}}
\patchcmd{\l@subsection}{2.3em}{2.7em}{}{\PackageError{glm}{Unable to adjust subsection contents spacing}{}}
\makeatother
\AtBeginDocument{\addtocontents{toc}{\protect\small}}
