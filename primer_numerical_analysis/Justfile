PDF_EXTRA   := "--lua-filter=" + MERMAID_FILTER + " --number-sections --shift-heading-level-by=-1 --include-in-header=extra-fonts.latex"

# Generate R figures (inside rocker container)
plots:
  {{OCI}} run --rm {{OCI_FLAGS}} \
    -v "{{REPO_ROOT}}:/repo{{MOUNT_SUFFIX}}" \
    -w "/repo/{{PROJECT_DIR}}" \
    {{ROCKER}} \
    Rscript generate_plots.R

# Generate figures then render both HTML and PDF
full: plots html-variants html pdf

