FROM docker.io/library/julia:1.12.7-bookworm@sha256:83c49705e6702c8a6e674be67d3c57e489a50df3e50997c84da49b5594808563

ENV JULIA_DEPOT_PATH=/opt/julia \
    JULIA_PKG_PRECOMPILE_AUTO=0

WORKDIR /opt/primer-julia
COPY Project.toml Manifest.toml ./
RUN julia --project=/opt/primer-julia -e 'using Pkg, SHA; manifest_hash = sha256(read("Manifest.toml")); Pkg.instantiate(); Pkg.precompile(); @assert sha256(read("Manifest.toml")) == manifest_hash "Pkg changed the committed Manifest.toml lock"'

COPY probe.jl /usr/local/bin/primer-julia-probe.jl
ENTRYPOINT ["julia", "--project=/opt/primer-julia", "/usr/local/bin/primer-julia-probe.jl"]
